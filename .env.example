# Copy to .env (gitignored) and fill in. Every backend or resolver whose key is
# missing skips with a clear message instead of crashing; `bakeoff` lists which
# backends ran and which were skipped.

# OpenRouter: one key for Qwen3-VL, Gemini, Claude, GPT vision models (openrouter.ai/keys)
OPENROUTER_API_KEY=

# eScriptorium: a self-hosted or lab-hosted instance (docker compose from gitlab.com/scripta/escriptorium).
# Token from the profile page on the instance. Optional: a recognition model name/id and a document name.
ESCRIPTORIUM_URL=
ESCRIPTORIUM_TOKEN=
ESCRIPTORIUM_MODEL=auto
ESCRIPTORIUM_DOCUMENT=mueser-prototypes bake-off

# Optional, not needed for the baseline: Mistral OCR (direct API) and Transkribus (API needs the Scholar plan)
MISTRAL_API_KEY=
TRANSKRIBUS_USER=
TRANSKRIBUS_PASSWORD=

# GeoNames: free web services need a username with web services ENABLED (geonames.org/manageaccount)
GEONAMES_USERNAME=

# Hugging Face: only needed for gated models or to upload fine-tunes
HF_TOKEN=

# Default models (OpenRouter IDs). Override per run with --model.
VLM_MODEL_DEFAULT=qwen/qwen3-vl-235b-a22b-instruct
VLM_MODEL_FRONTIER=google/gemini-3.8-flash
VLM_MODEL_FREE=google/gemma-4-31b-it:free
EXTRACT_MODEL=google/gemini-3.8-flash

# Allmaps georeference annotation URL for the historical-map overlay (see 01-use-cases/maps/02-historical-map-overlay).
# Empty = overlay toggle disabled. Georeference a map at https://editor.allmaps.org and paste its annotation URL.
ALLMAPS_ANNOTATION_URL=
