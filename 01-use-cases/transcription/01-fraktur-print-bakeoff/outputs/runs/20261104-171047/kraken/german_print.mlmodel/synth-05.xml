  <Page imageFilename="synth-05.png" imageWidth="1600" imageHeight="2200">
    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="513,152 1085,152 1085,198 513,198"/>
        <Baseline points="514,180 1085,183"/>
        <TextEquiv conf="0.989"><Unicode>von danzig nach Rönigsberg und Memel.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="151,232 1421,232 1421,277 151,277"/>
        <Baseline points="152,262 1421,266"/>
        <TextEquiv conf="0.994"><Unicode>den 25ten fuhren wir über die Rehrung nach Elbing, und den 28ten erreichten wir Rönigsberg</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="150,281 1364,281 1364,322 150,322"/>
        <Baseline points="151,312 1364,310"/>
        <TextEquiv conf="1.000"><Unicode>in Preußen. Hier beſuchten wir den Profeſſor Rant, der uns ſehr höflich aufnahm, aber von</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="150,328 1386,328 1386,375 150,375"/>
        <Baseline points="151,361 1386,359"/>
        <TextEquiv conf="0.993"><Unicode>ſeiner Philoſophie nicht reden wollte. die Stadt beſteht eigentlich aus drey Städten, Alltſtadt,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="151,376 485,376 485,422 151,422"/>
        <Baseline points="152,409 485,407"/>
        <TextEquiv conf="0.999"><Unicode>Löbenicht und Rneiphof.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="154,430 1406,430 1406,466 154,466"/>
        <Baseline points="154,455 1406,455"/>
        <TextEquiv conf="0.997"><Unicode>Den 30ten fuhren wir durch Neuſtadt, ein kleines Städtchen, deſſen Namen man in Deutſchland</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="152,473 656,473 656,514 152,514"/>
        <Baseline points="154,504 656,502"/>
        <TextEquiv conf="0.999"><Unicode>wohl hundertmal findet, nach Labiau.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="151,524 1410,524 1410,562 151,562"/>
        <Baseline points="152,552 1410,550"/>
        <TextEquiv conf="0.995"><Unicode>Den 2. Auguſt kamen wir nach Memel, der letzten Stadt des Rönigreichs. Der Hafen war voll</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="150,568 1086,568 1086,611 150,611"/>
        <Baseline points="151,601 1086,597"/>
        <TextEquiv conf="0.996"><Unicode>von Schiffen aus holland und England, welche Holz und Flachs laden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="151,617 1293,617 1293,660 151,660"/>
        <Baseline points="152,650 1293,646"/>
        <TextEquiv conf="0.997"><Unicode>den Sten waren wir in Tilſit an der Memel, und kehrten von da über Inſterburg nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="154,666 426,666 426,712 154,712"/>
        <Baseline points="154,696 426,696"/>
        <TextEquiv conf="0.989"><Unicode>Rönigsberg zurück.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="151,712 1410,712 1410,759 151,759"/>
        <Baseline points="152,743 1410,740"/>
        <TextEquiv conf="0.989"><Unicode>den 20ten fluguſt erreichten wir auf dem Rückwege Stettin, und den 23ten Lolberg, wo dieſes</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="154,761 402,761 402,811 154,811"/>
        <Baseline points="154,790 402,790"/>
        <TextEquiv conf="0.969"><Unicode>Tagebuch ſchließt.</Unicode></TextEquiv>
      </TextLine>
