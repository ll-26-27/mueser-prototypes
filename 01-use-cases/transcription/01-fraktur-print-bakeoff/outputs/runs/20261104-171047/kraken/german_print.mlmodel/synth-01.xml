        <Baseline points="281,185 1313,185"/>
        <TextEquiv conf="0.993"><Unicode>Reiſe⸗Tagebuch von Breßlau nach Königsberg, im Sommer 1786.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="151,232 1437,232 1437,282 151,282"/>
        <Baseline points="152,268 1437,265"/>
        <TextEquiv conf="0.995"><Unicode>Den 12. Junius 1786 reiſeten wir des Morgens um fünf Ahr von Breßlau ab. Der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="151,287 1430,287 1430,338 151,338"/>
        <Baseline points="152,322 1430,319"/>
        <TextEquiv conf="0.994"><Unicode>Herr von Zedlitz hatte uns Briefe an die Magiſträte der Städte mitgegeben, durch</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="151,343 1302,343 1302,386 151,386"/>
        <Baseline points="152,376 1302,374"/>
        <TextEquiv conf="0.992"><Unicode>welche wir kommen würden, und ſein Bedienter begleitete uns bis vor das</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="151,396 1398,396 1398,440 151,440"/>
        <Baseline points="152,430 1398,427"/>
        <TextEquiv conf="0.993"><Unicode>Oder⸗Thor. Der Weg gienq über Neumarkt, wo wir die Pferde wechſelten, nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="151,451 1298,451 1298,493 151,493"/>
        <Baseline points="152,484 1298,481"/>
        <TextEquiv conf="0.994"><Unicode>Lieqnitz, einer wohlgebauten Stadt an der Katzbach, die wir gegen Abend</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="151,506 1337,506 1337,547 151,547"/>
        <Baseline points="151,536 1337,536"/>
        <TextEquiv conf="1.000"><Unicode>erreichten. Man zeigte uns das Schloß und die Ritter⸗Akademie, welche der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="154,558 691,558 691,609 154,609"/>
        <Baseline points="154,592 691,592"/>
        <TextEquiv conf="0.999"><Unicode>König im Jahre 1708 geſtiſtet hat.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="152,613 1371,613 1371,656 152,656"/>
        <Baseline points="152,645 1371,645"/>
        <TextEquiv conf="0.995"><Unicode>Den 14ten ſuhren wir über Haynau nach Bunzlau. Die Töpfer⸗Waaren dieſer</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="151,666 1372,666 1372,710 151,710"/>
        <Baseline points="152,700 1372,697"/>
        <TextEquiv conf="0.999"><Unicode>Stadt ſind in ganz Schleſien berühmt, und wir kauſten einige Krüge für unſere</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="152,719 1390,719 1390,765 152,765"/>
        <Baseline points="154,755 1390,751"/>
        <TextEquiv conf="0.996"><Unicode>Freunde in Verlin. Die Gegend iſt fruchtbar, und die Dörfer ſind beſſer gebauet</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="151,773 426,773 426,820 151,820"/>
        <Baseline points="152,806 426,809"/>
        <TextEquiv conf="1.000"><Unicode>als in der Mark.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="152,827 1371,827 1371,872 152,872"/>
        <Baseline points="154,862 1371,859"/>
        <TextEquiv conf="0.998"><Unicode>Den 15ten kamen wir nach Görlitz, wo wir zwey Tage blieben. Der Rathsherr</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="154,882 1400,882 1400,926 154,926"/>
        <Baseline points="155,916 1400,914"/>
        <TextEquiv conf="0.999"><Unicode>Anton führte uns auf die Landeskrone, von welcher man das Rieſengebirge ſieht.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="151,935 1361,935 1361,986 151,986"/>
        <Baseline points="152,971 1361,968"/>
        <TextEquiv conf="1.000"><Unicode>In der Peterskirche ſahen wir die Bibliothek, welche über zehntauſend Bände</Unicode></TextEquiv>
      </TextLine>
