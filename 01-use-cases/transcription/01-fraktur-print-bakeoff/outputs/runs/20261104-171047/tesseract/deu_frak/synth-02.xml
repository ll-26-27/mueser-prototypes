      <TextLine id="l1">
        <Coords points="590,161 1009,161 1009,196 590,196"/>
        <TextEquiv conf="0.815"><Unicode>Von Görlitz nach Dreszden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,244 1386,244 1386,280 161,280"/>
        <TextEquiv conf="0.876"><Unicode>Den 17ten reiseten wir nach Vautzen. der Hauptstadt der Oberlausitz. Die Stadt</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="162,297 1380,297 1380,335 162,335"/>
        <TextEquiv conf="0.876"><Unicode>liegt auf einem Felsen über der Spree. und hat viele alte Thürme Hier wohnen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,352 1296,352 1296,386 161,386"/>
        <TextEquiv conf="0.894"><Unicode>Wenden und Deutsche bey einander. und man hört auf dem Markte beyde</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,406 313,406 313,442 161,442"/>
        <TextEquiv conf="0.860"><Unicode>Sprachen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,460 1435,460 1435,497 161,497"/>
        <TextEquiv conf="0.863"><Unicode>Den 19ten erreichten wir Dreszden gegen Mittag. Wir stiegen in dem Gasthofe zum</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,514 1408,514 1408,551 161,551"/>
        <TextEquiv conf="0.886"><Unicode>goldenen Engel ab. und giengen sogleich auf die Brücke. welche mit Recht für die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,568 1296,568 1296,605 161,605"/>
        <TextEquiv conf="0.923"><Unicode>schönste in Deutschland gehalten wird. Den folgenden Tag besahen wir die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="161,622 1414,622 1414,659 161,659"/>
        <TextEquiv conf="0.804"><Unicode>GemäldesGallerie. das grüne Gewölbe und die Bibliothec Herr Hosrath Adelung</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,676 598,676 598,713 161,713"/>
        <TextEquiv conf="0.877"><Unicode>empfieng uns sehr freundlich.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="161,729 1406,729 1406,765 161,765"/>
        <TextEquiv conf="0.916"><Unicode>Den 21ten fuhren wir die Elbe hinab nach Meißen. wo wir die PorcellansFabril</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="162,783 1264,783 1264,819 162,819"/>
        <TextEquiv conf="0.890"><Unicode>besuchten. Man erlaubt den Fremden nicht. die Masse zu sehen. aber die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,838 692,838 692,874 161,874"/>
        <TextEquiv conf="0.838"><Unicode>MahlersStuben stehen jedem offen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="161,892 1382,892 1382,929 161,929"/>
        <TextEquiv conf="0.911"><Unicode>Den 23ten lamen wir nach Leipzig. Die Messe war vorüber. und die Stadt war</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="161,946 1332,946 1332,983 161,983"/>
        <TextEquiv conf="0.893"><Unicode>ruhig. Wir besuchten den Vuchhändler Vreitlops und sahen seine Druckerey.</Unicode></TextEquiv>
      </TextLine>
