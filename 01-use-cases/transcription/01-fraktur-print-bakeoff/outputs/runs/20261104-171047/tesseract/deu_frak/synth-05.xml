  <Page imageFilename="synth-05.png" imageWidth="1600" imageHeight="2200">
    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="522,161 1079,161 1079,195 522,195"/>
        <TextEquiv conf="0.887"><Unicode>Von Danzig nach Königsberg und Memel.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,243 1418,243 1418,277 161,277"/>
        <TextEquiv conf="0.902"><Unicode>Den 25ten fuhren wir über die Nehrung nach Elbing, und den 28ten erreichten wir Königsberg</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="161,291 1357,291 1357,326 161,326"/>
        <TextEquiv conf="0.905"><Unicode>in Preußen. Hier besuchten wir den Professor Kant, der uns sehr höflich aufnahm, aber von</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,338 1381,338 1381,373 161,373"/>
        <TextEquiv conf="0.880"><Unicode>seiner Philosophie nicht reden wollte. Die Stadt besteht eigentlich aus drey Städten, Altstadt,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,387 479,387 479,421 161,421"/>
        <TextEquiv conf="0.857"><Unicode>Löbenicht und Kneiphof.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,434 1401,434 1401,469 161,469"/>
        <TextEquiv conf="0.908"><Unicode>Den 30ten fuhren wir durch Neustadt, ein kleines Städtchen, dessen Namen man in Deutschland</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,483 651,483 651,517 161,517"/>
        <TextEquiv conf="0.904"><Unicode>wohl hundertmal findet, nach Labiau.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,530 1405,530 1405,565 161,565"/>
        <TextEquiv conf="0.918"><Unicode>Den 2. August kamen wir nach Memel, der letzten Stadt des Königreichs. Der Hafen war voll</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="160,578 1082,578 1082,613 160,613"/>
        <TextEquiv conf="0.942"><Unicode>von Schiffen aus Holland und England, welche Holz und Flachs laden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,627 1286,627 1286,661 161,661"/>
        <TextEquiv conf="0.941"><Unicode>Den 5ten waren wir in Tilsit an der Memel, und kehrten von da über Insterburg nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="161,675 419,675 419,708 161,708"/>
        <TextEquiv conf="0.745"><Unicode>Königsberg zurück.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="161,722 1406,722 1406,757 161,757"/>
        <TextEquiv conf="0.923"><Unicode>Den 20ten August erreichten wir auf dem Rückwege Stettin, und den 23ten Colberg, wo dieses</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,771 395,771 395,806 161,806"/>
        <TextEquiv conf="0.795"><Unicode>Tagebuch schließt.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
