      <TextLine id="l2">
        <Coords points="161,238 1351,238 1351,274 161,274"/>
        <TextEquiv conf="0.875"><Unicode>Den 26ten waren wir in Halle, und besahen das Waisenhaus des seligen Franc-le</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="161,288 1222,288 1222,325 161,325"/>
        <TextEquiv conf="0.880"><Unicode>welches eine kleine Stadt für sich ist. Der Professor Forster zeigte uns die</Unicode></TextEquiv>
      </TextLine>
