      </TextLine>
      <TextLine id="l10">
        <Coords points="161,646 1364,646 1364,682 161,682"/>
        <TextEquiv conf="0.890"><Unicode>der Burgstraße Die Stadt ist groß und regelmäßig gebauet, aber die Straßen sind</Unicode></TextEquiv>
      </TextLine>
