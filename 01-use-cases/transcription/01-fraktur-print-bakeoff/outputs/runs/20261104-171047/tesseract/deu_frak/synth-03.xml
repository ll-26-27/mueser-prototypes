      </TextLine>
      <TextLine id="l7">
        <Coords points="161,494 932,494 932,529 161,529"/>
        <TextEquiv conf="0.877"><Unicode>Gebäude, welches wir aus dieser Neise gesehen haben.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,543 1433,543 1433,581 161,581"/>
        <TextEquiv conf="0.887"><Unicode>Den 1. Julius fuhren wir durch Brandenburg, eine alte Stadt mit zwey Dom-Kirchen,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="161,595 1417,595 1417,631 161,631"/>
