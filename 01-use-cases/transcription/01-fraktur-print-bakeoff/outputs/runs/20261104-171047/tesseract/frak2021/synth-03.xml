    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="611,160 988,160 988,196 611,196"/>
        <TextEquiv conf="0.905"><Unicode>Von Leipzig nach Berlin.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,238 1351,238 1351,274 161,274"/>
        <TextEquiv conf="0.851"><Unicode>Den 26ten waren wir in Halle, und beſahen das Waiſenhaus des ſeligen Francke,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="161,288 1222,288 1222,325 161,325"/>
        <TextEquiv conf="0.916"><Unicode>welehes eine kleine Stadt für ſich iſt. Der Profeſſor Forſter zeigte uns die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,341 511,341 511,376 161,376"/>
        <TextEquiv conf="0.850"><Unicode>Naturalien-Sammlung.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,391 1388,391 1388,427 161,427"/>
        <TextEquiv conf="0.900"><Unicode>Den 28ten erreichten wir Magdeburg. Die Feſtungs-Werke ſind ſehr ſtark, und man</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,442 1296,442 1296,478 161,478"/>
        <TextEquiv conf="0.922"><Unicode>läßt keinen Fremden ohne Begleitung auf die Wälle. Der Dom iſt das größte</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,494 932,494 932,529 161,529"/>
        <TextEquiv conf="0.920"><Unicode>Gebäude, welehes wir auf dieſer Reiſe geſehen haben.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,543 1433,543 1433,581 161,581"/>
        <TextEquiv conf="0.857"><Unicode>Den 1. Julius fuhren wir dureh Brandenburg, eine alte Stadt mit zwey Dom⸗Kirchen,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="161,595 1417,595 1417,631 161,631"/>
        <TextEquiv conf="0.870"><Unicode>und kamen den 2ten Abends in Berlin an. Wir wohnten bey dem Kaufmann Itzig in</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,646 1364,646 1364,682 161,682"/>
        <TextEquiv conf="0.919"><Unicode>der Burgſtraße. Die Stadt iſt groß und regelmäßig gebauet, aber die Straßen ſind</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="160,698 257,698 257,733 160,733"/>
        <TextEquiv conf="0.920"><Unicode>ſandig.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="161,748 1386,748 1386,782 161,782"/>
        <TextEquiv conf="0.852"><Unicode>Hier blieben wir eine Woche. Den ſten ſahen wir die Parade vor dem Sehloſſe, und</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,800 937,800 937,833 161,833"/>
        <TextEquiv conf="0.889"><Unicode>den 7ten fuhren wir nach Potsdam und Sans-Souei.</Unicode></TextEquiv>
      </TextLine>
