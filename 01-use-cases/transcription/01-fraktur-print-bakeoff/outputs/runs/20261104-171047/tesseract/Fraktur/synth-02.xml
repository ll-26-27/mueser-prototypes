  <Page imageFilename="synth-02.png" imageWidth="1600" imageHeight="2200">
    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="590,161 1009,161 1009,196 590,196"/>
        <TextEquiv conf="0.938"><Unicode>Von Görlitz nach Dreßden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,244 1386,244 1386,280 161,280"/>
        <TextEquiv conf="0.839"><Unicode>Den 17ten reiſeten wir nach Bautzen, der Hauptſtadt der Oberlauſitz. Die Stadt</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="162,297 1380,297 1380,335 162,335"/>
        <TextEquiv conf="0.953"><Unicode>liegt auf einem Felſen über der Spree, und hat viele alte Thürme. Hier wohnen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,352 1296,352 1296,386 161,386"/>
        <TextEquiv conf="0.921"><Unicode>Wenden und Deutſche bey einander, und man hört auf dem Markte beyde</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,406 313,406 313,442 161,442"/>
        <TextEquiv conf="0.950"><Unicode>Sprachen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,460 1435,460 1435,497 161,497"/>
        <TextEquiv conf="0.915"><Unicode>Den 19ten erreichten wir Dreßden gegen Mittag. Wir ſtiegen in dem Gaſthofe zum</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,514 1408,514 1408,551 161,551"/>
        <TextEquiv conf="0.953"><Unicode>goldenen Engel ab, und giengen ſogleich auf die Brücke, welche mit Recht für die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,568 1296,568 1296,605 161,605"/>
        <TextEquiv conf="0.918"><Unicode>\chönſte in Deutſchland gehalten wird. Den folgenden Tag beſahen wir die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="161,622 1414,622 1414,659 161,659"/>
        <TextEquiv conf="0.952"><Unicode>Gemälde-Gallerie, das grüne Gewölbe und die Bibliothek. Herr Hofrath Adelung</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,676 598,676 598,713 161,713"/>
        <TextEquiv conf="0.807"><Unicode>empfieng uns ſehr freundlich.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="161,729 1406,729 1406,765 161,765"/>
        <TextEquiv conf="0.933"><Unicode>Den 2lten fuhren wir die Elbe hinab nach Meißen, wo wir die Porcellan-Fabrik</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="162,783 1264,783 1264,819 162,819"/>
        <TextEquiv conf="0.957"><Unicode>beſuchten. Man erlaubt den Fremden nicht, die Maſſe zu ſehen, aber die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,838 692,838 692,874 161,874"/>
        <TextEquiv conf="0.785"><Unicode>Makhler-Stuben ſehen jedem offen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="161,892 1382,892 1382,929 161,929"/>
        <TextEquiv conf="0.953"><Unicode>Den 23ten kamen wir nach Leipzig. Die Meſſe war vorüber, und die Stadt war</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="161,946 1332,946 1332,983 161,983"/>
        <TextEquiv conf="0.952"><Unicode>ruhig. Wir beſuchten den Buchhändler Breitkopf und ſahen ſeine Druckerey.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
