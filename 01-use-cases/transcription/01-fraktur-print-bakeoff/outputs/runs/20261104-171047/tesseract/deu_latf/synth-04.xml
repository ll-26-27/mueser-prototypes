    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="586,160 988,160 988,196 586,196"/>
        <TextEquiv conf="0.943"><Unicode>Von Berlin nach Danzig.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="149,236 1369,236 1369,289 149,289"/>
        <TextEquiv conf="0.934"><Unicode>Den Iten Julius reiſeten wir von Berlin ab nach Frankfurth an der Oder. Die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="150,292 1371,292 1371,340 150,340"/>
        <TextEquiv conf="0.958"><Unicode>Univerſität iſt klein, aber die Meſſe bringt viele Polen und Juden in die Stadt.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="151,345 1365,345 1365,394 151,394"/>
        <TextEquiv conf="0.941"><Unicode>Den Uten fuhren wir über Landsberg an der Warthe. Die Gegend iſt hier flach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="152,398 1412,398 1412,450 152,450"/>
        <TextEquiv conf="0.943"><Unicode>und ſumpfig; der König hat die Brüche austrocknen und Coloniſten anſetzen laſſen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="152,454 1333,454 1333,499 152,499"/>
        <TextEquiv conf="0.953"><Unicode>Den 14ten kamen wir nach Poſen, der Hauptſtadt von Großpolen. Die Stadt</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="153,507 1391,507 1391,560 153,560"/>
        <TextEquiv conf="0.959"><Unicode>gehört ſeit dem Jahre 1793 nicht mehr zu Polen, ſchrieb ein ſpäterer Leſer an den</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="154,562 1392,562 1392,609 154,609"/>
        <TextEquiv conf="0.944"><Unicode>Rand. Wir ſahen den Dom und das Rathhaus, welches von Italiänern gebauet</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="154,630 282,630 282,666 154,666"/>
        <TextEquiv conf="0.960"><Unicode>ſeyn ſoll.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="155,669 1428,669 1428,716 155,716"/>
        <TextEquiv conf="0.950"><Unicode>Den 18ten erreichten wir Thorn an der Weichſel. Hier iſt Copernicus geboren; man</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="156,723 1423,723 1423,775 156,775"/>
        <TextEquiv conf="0.960"><Unicode>zeigte uns ſein Haus. Die Pfefferkuchen von Thorn ſind in ganz Preußen bekannt.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="157,779 1274,779 1274,823 157,823"/>
        <TextEquiv conf="0.945"><Unicode>Den 22ten kamen wir nach Danzig. Die Stadt iſt reich und ſtolz, und die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="158,831 1416,831 1416,881 158,881"/>
        <TextEquiv conf="0.878"><Unicode>Kaufleute reden Engliſch und Holländiſch. Vom Thurme der Marien-Kirche ſicht</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="159,899 357,899 357,930 159,930"/>
        <TextEquiv conf="0.960"><Unicode>man die See.</Unicode></TextEquiv>
      </TextLine>
