      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Von Leipzig nach Berlin.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 26ten waren wir in Halle, und beſahen das Waiſenhaus des ſeligen Francke,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>welches eine kleine Stadt für ſich iſt. Der Profeſſor Forſter zeigte uns die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Naturalien-Sammlung.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 28ten erreichten wir Magdeburg. Die Feſtungs-Werke ſind ſehr ſtark, und man</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>läßt keinen Fremden ohne Begleitung auf die Wälle. Der Dom iſt das größte</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gebäude, welches wir auf dieſer Reiſe geſehen haben.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 1. Julius fuhren wir durch Brandenburg, eine alte Stadt mit zwey Dom-Kirchen,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>und kamen den 2ten Abends in Berlin an. Wir wohnten bey dem Kaufmann Itzig in</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>der Burgſtraße. Die Stadt iſt groß und regelmäßig gebauet, aber die Straßen ſind</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ſandig.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Hier blieben wir eine Woche. Den 5ten ſahen wir die Parade vor dem Schloſſe, und</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>den 7ten fuhren wir nach Potsdam und Sans-Souci.</Unicode></TextEquiv>
      </TextLine>
