      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Reiſe=Tagebuch von Breßlau nach Königsberg, im Sommer 1786.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 12. Junius 1786 reiſeten wir des Morgens um fünf Uhr von Breßlau ab. Der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Herr von Zedlitz hatte uns Briefe an die Magiſträte der Städte mitgegeben, durch</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>welche wir kommen würden, und ſein Bedienter begleitete uns bis vor das</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Oder=Thor. Der Weg gieng über Neumarkt, wo wir die Pferde wechſelten, nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Liegnitz, einer wohlgebauten Stadt an der Katzbach, die wir gegen Abend</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>erreichten. Man zeigte uns das Schloß und die Ritter=Akademie, welche der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>König im Jahre 1708 geſtiftet hat.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 14ten fuhren wir über Haynau nach Bunzlau. Die Töpfer=Waaren dieſer</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Stadt ſind in ganz Schleſien berühmt, und wir kauften einige Krüge für unſere</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Freunde in Berlin. Die Gegend iſt fruchtbar, und die Dörfer ſind beſſer gebauet</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>als in der Mark.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 15ten kamen wir nach Görlitz, wo wir zwey Tage blieben. Der Rathsherr</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Anton führte uns auf die Landeskrone, von welcher man das Rieſengebirge ſieht.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>In der Peterskirche ſahen wir die Bibliothek, welche über zehntauſend Bände</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l16">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>enthalten ſoll.</Unicode></TextEquiv>
      </TextLine>
