  <Page imageFilename="synth-05.png" imageWidth="1600" imageHeight="2200">
    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Von Danzig nach Königsberg und Memel.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 25ten fuhren wir über die Nehrung nach Elbing, und den 28ten erreichten wir Königsberg</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>in Preußen. Hier besuchten wir den Professor Kant, der uns sehr höflich aufnahm, aber von</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>seiner Philosophie nicht reden wollte. Die Stadt besteht eigentlich aus drey Städten, Altstadt,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Löbenicht und Kneiphof.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 30ten fuhren wir durch Neustadt, ein kleines Städtchen, dessen Namen man in Deutschland</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>wohl hundertmal findet, nach Labiau.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 2. August kamen wir nach Memel, der letzten Stadt des Königreichs. Der Hafen war voll</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>von Schiffen aus Holland und England, welche Holz und Flachs laden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 5ten waren wir in Tilsit an der Memel, und kehrten von da über Insterburg nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Königsberg zurück.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 20ten August erreichten wir auf dem Rückwege Stettin, und den 23ten Colberg, wo dieses</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Tagebuch schließt.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
  </Page>
