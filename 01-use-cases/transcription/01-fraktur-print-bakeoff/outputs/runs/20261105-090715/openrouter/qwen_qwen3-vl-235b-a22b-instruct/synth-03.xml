    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Von Leipzig nach Berlin.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 26ten waren wir in Halle, und besahen das Waisenhaus des seligen Francke,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>welches eine kleine Stadt für sich ist. Der Professor Forster zeigte uns die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Naturalien-Sammlung.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 28ten erreichten wir Magdeburg. Die Festungs-Werke sind sehr stark, und man</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>läßt keinen Fremden ohne Begleitung auf die Wälle. Der Dom ist das größte</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gebäude, welches wir auf dieser Reise gesehen haben.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 1. Julius fuhren wir durch Brandenburg, eine alte Stadt mit zwen Dom-Kirchen,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>und kamen den 2ten Abends in Berlin an. Wir wohnten bey dem Kaufmann Izig in</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>der Burgstraße. Die Stadt ist groß und regelmäßig gebauet, aber die Straßen sind</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>sandig.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Hier blieben wir eine Woche. Den 5ten sahen wir die Parade vor dem Schlosse, und</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>den 7ten fuhren wir nach Potsdam und Sans-Souci.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
