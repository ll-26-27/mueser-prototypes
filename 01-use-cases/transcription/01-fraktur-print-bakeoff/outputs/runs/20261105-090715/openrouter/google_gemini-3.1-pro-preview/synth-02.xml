  <Page imageFilename="synth-02.png" imageWidth="1600" imageHeight="2200">
    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Von Görlitz nach Dreßden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 17ten reiſeten wir nach Bautzen, der Hauptſtadt der Oberlauſitz. Die Stadt</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>liegt auf einem Felſen über der Spree, und hat viele alte Thürme. Hier wohnen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Wenden und Deutſche bey einander, und man hört auf dem Markte beyde</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Sprachen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 19ten erreichten wir Dreßden gegen Mittag. Wir ſtiegen in dem Gaſthofe zum</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>goldenen Engel ab, und giengen ſogleich auf die Brücke, welche mit Recht für die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ſchönſte in Deutſchland gehalten wird. Den folgenden Tag beſahen wir die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gemälde-Gallerie, das grüne Gewölbe und die Bibliothek. Herr Hofrath Adelung</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>empfieng uns ſehr freundlich.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 21ten fuhren wir die Elbe hinab nach Meißen, wo wir die Porcellan-Fabrik</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>beſuchten. Man erlaubt den Fremden nicht, die Maſſe zu ſehen, aber die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Mahler-Stuben ſtehen jedem offen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Den 23ten kamen wir nach Leipzig. Die Meſſe war vorüber, und die Stadt war</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ruhig. Wir beſuchten den Buchhändler Breitkopf und ſahen ſeine Druckerey.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
