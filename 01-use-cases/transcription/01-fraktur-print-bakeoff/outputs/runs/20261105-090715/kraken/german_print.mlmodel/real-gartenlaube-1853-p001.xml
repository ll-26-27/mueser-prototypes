      <TextLine id="l10">
        <Coords points="634,1454 1352,1454 1352,1504 634,1504"/>
        <Baseline points="635,1487 1352,1481"/>
        <TextEquiv conf="0.975"><Unicode>Wöchentlich ein ganzer Pogen mit Jluſtrationen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="336,1500 1656,1500 1656,1565 336,1565"/>
        <Baseline points="338,1545 1656,1533"/>
        <TextEquiv conf="1.000"><Unicode>Durch alle Buchhandlungen und Poſtämter für 10 Ngr. vierteljährlich zu beziehen.</Unicode></TextEquiv>
