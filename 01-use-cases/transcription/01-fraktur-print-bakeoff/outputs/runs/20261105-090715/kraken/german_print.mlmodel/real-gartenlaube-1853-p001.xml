      <TextLine id="l37">
        <Coords points="135,2585 1932,2585 1932,2659 135,2659"/>
        <Baseline points="137,2626 1932,2630"/>
        <TextEquiv conf="0.985"><Unicode>Die Gartenlanbe erſcheint wöchentlich ſiſt vielen Illuſtrationen und koſtet vierteljährlich nur 10 Agr. Alle Buchhandlungen</Unicode></TextEquiv>
      </TextLine>
