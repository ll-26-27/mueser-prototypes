    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="580,151 1015,151 1015,200 580,200"/>
        <Baseline points="581,185 1015,183"/>
        <TextEquiv conf="1.000"><Unicode>Von Görlitz nach Dreßden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="151,233 1390,233 1390,282 151,282"/>
        <Baseline points="152,268 1390,265"/>
        <TextEquiv conf="0.999"><Unicode>Den Uten reiſeten wir nach Bautzen, der Hauptſtadt der Oberlauſitz. Die Stadt</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="152,289 1386,289 1386,332 152,332"/>
        <Baseline points="152,321 1386,321"/>
        <TextEquiv conf="1.000"><Unicode>liegt auf einem Felſen über der Spree, und hat viele alte Thürme. Hier wohnen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="154,343 1302,343 1302,386 154,386"/>
        <Baseline points="155,375 1302,374"/>
        <TextEquiv conf="1.000"><Unicode>Wenden und Deutſche bey einander, und man hört auf dem Markte beyde</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="150,398 322,398 322,444 150,444"/>
        <Baseline points="150,430 322,430"/>
        <TextEquiv conf="1.000"><Unicode>Sprachen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="152,452 1438,452 1438,495 152,495"/>
        <Baseline points="152,484 1438,484"/>
        <TextEquiv conf="1.000"><Unicode>Den 19ten erreichten wir Dreßden gegen Mittag. Wir ſtiegen in dem Gaſthofe zum</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="151,504 1415,504 1415,552 151,552"/>
        <Baseline points="152,539 1415,536"/>
        <TextEquiv conf="1.000"><Unicode>goldenen Engel ab, und giengen ſogleich auf die Brücke, welche mit Recht für die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="151,558 1304,558 1304,603 151,603"/>
        <Baseline points="152,591 1304,589"/>
        <TextEquiv conf="1.000"><Unicode>ſchönſte in Deutſchland gehalten wird. Den ſolgenden Tag beſahen wir die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="151,611 1417,611 1417,660 151,660"/>
        <Baseline points="152,642 1417,646"/>
        <TextEquiv conf="0.999"><Unicode>Gemälde⸗Gallerie, das grüne Gewölbe und die Bibliothek. Herr Hofrath Adelung</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="151,668 605,668 605,710 151,710"/>
        <Baseline points="151,700 605,700"/>
        <TextEquiv conf="0.994"><Unicode>empfieng uns ſehr freundlich.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="154,721 1411,721 1411,765 154,765"/>
        <Baseline points="154,754 1411,754"/>
        <TextEquiv conf="0.993"><Unicode>Den Alten ſuhren wir die Elbe hinab nach Meißen, wo wir die Porcellan⸗Fabrik</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="152,774 1272,774 1272,818 152,818"/>
        <Baseline points="152,807 1272,807"/>
        <TextEquiv conf="1.000"><Unicode>beſuchten. Man erlaubt den Fremden nicht, die Maſſe zu ſehen, aber die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="154,829 700,829 700,872 154,872"/>
        <Baseline points="154,862 700,862"/>
        <TextEquiv conf="1.000"><Unicode>Mahler⸗Stuben ſtehen jedem offen.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="152,881 1386,881 1386,931 152,931"/>
        <Baseline points="154,917 1386,914"/>
        <TextEquiv conf="1.000"><Unicode>Den 23ten kamen wir nach Leipzig. Die Meſſe war vorüber, und die Stadt war</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="152,936 1334,936 1334,980 152,980"/>
        <Baseline points="154,970 1334,968"/>
        <TextEquiv conf="0.999"><Unicode>ruhig. Wir beſuchten den Buchhändler Breitkopf und ſahen ſeine Druckerey.</Unicode></TextEquiv>
      </TextLine>
