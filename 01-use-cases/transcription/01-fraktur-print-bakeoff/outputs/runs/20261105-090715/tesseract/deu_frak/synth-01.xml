    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="290,161 1310,161 1310,198 290,198"/>
        <TextEquiv conf="0.870"><Unicode>Neise-Tagebuch von Vreßlau nach Königsberg im Sommer 1786.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,244 1435,244 1435,282 161,282"/>
        <TextEquiv conf="0.873"><Unicode>Den 12. Junius 1786 reiseten wir des Morgens um fünf Uhr von Vreßlau ab. Der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="161,298 1427,298 1427,335 161,335"/>
        <TextEquiv conf="0.872"><Unicode>Herr von Zedlitz hatte uns Vriefe an die Magisträte der Städte mitgegeben. durch</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,352 1297,352 1297,389 161,389"/>
        <TextEquiv conf="0.914"><Unicode>welche wir kommen würden. und sein Vedienter begleitete uns bis vor das</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,406 1394,406 1394,443 161,443"/>
        <TextEquiv conf="0.871"><Unicode>Oder-Thor. Der Weg gieng über Neumarkt. wo wir die Pferde wechselten. nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,460 1293,460 1293,497 161,497"/>
        <TextEquiv conf="0.892"><Unicode>Liegnit3. einer wohlgebauten Stadt an der Katzbach die wir gegen Abend</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,514 1331,514 1331,551 161,551"/>
        <TextEquiv conf="0.888"><Unicode>erreichten. Man zeigte uns das Schloß und die Nitter-Akademie. welche der</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,568 684,568 684,606 161,606"/>
        <TextEquiv conf="0.867"><Unicode>König im Jahre 1708 geskiftet hat.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="161,622 1364,622 1364,659 161,659"/>
        <TextEquiv conf="0.875"><Unicode>Den 14ten fuhren wir über Haynau nach Vunzlau. Die Töpfer-Waaren dieser</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,676 1366,676 1366,713 161,713"/>
        <TextEquiv conf="0.892"><Unicode>Stadt sind in ganz Schlesien berühmt. und wir kauften einige Krüge für unsere</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="161,729 1385,729 1385,767 161,767"/>
        <TextEquiv conf="0.883"><Unicode>Freunde in Berlin. Die Gegend ist fruchtbar. und die Dörfer sind besser gebauet</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="161,785 417,785 417,814 161,814"/>
        <TextEquiv conf="0.948"><Unicode>als in der Mark.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,838 1365,838 1365,875 161,875"/>
        <TextEquiv conf="0.901"><Unicode>Den 15ten kamen wir nach Görlit3. wo wir zwey Tage blieben. Der Rathsherr</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="161,892 1399,892 1399,929 161,929"/>
        <TextEquiv conf="0.898"><Unicode>Anton führte uns auf die Landeskrone. von welcher man das Niesengebirge sieht.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="161,946 1357,946 1357,982 161,982"/>
        <TextEquiv conf="0.885"><Unicode>Jn der Peterskirche sahen wir die Bibliothec welche über zehntausend Vände</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l16">
        <Coords points="161,1000 367,1000 367,1035 161,1035"/>
        <TextEquiv conf="0.880"><Unicode>enthalten soll.</Unicode></TextEquiv>
      </TextLine>
