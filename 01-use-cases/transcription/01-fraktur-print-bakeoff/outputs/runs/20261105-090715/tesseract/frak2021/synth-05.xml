    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="522,161 1079,161 1079,195 522,195"/>
        <TextEquiv conf="0.902"><Unicode>von Danzig nach Rönigsberg und Memel.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="161,243 1418,243 1418,277 161,277"/>
        <TextEquiv conf="0.902"><Unicode>Den 25ten fuhren wir über die Nehrung nach Elbing, und den 28ten erreichten wir Rönigsberg</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="161,291 1357,291 1357,326 161,326"/>
        <TextEquiv conf="0.917"><Unicode>in Preußen. hier beſuchten wir den Profeſſor Rant, der uns ſehr höflich aufnahm, aber von</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="161,338 1381,338 1381,373 161,373"/>
        <TextEquiv conf="0.854"><Unicode>ſeiner Philoſophie nicht reden wollte. die Staot beſteht eigentlich aus drey Städten, Altſtadt,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="161,387 479,387 479,421 161,421"/>
        <TextEquiv conf="0.553"><Unicode>LCöbenicht und Kneiphof.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="161,434 1401,434 1401,469 161,469"/>
        <TextEquiv conf="0.807"><Unicode>Den Zoten fuhren wir durch Neuſtadt, ein kleines Städtchen, deſſen Ramen man in Deutſchland</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="161,483 651,483 651,517 161,517"/>
        <TextEquiv conf="0.918"><Unicode>wohl hundertmal findet, nach Labiau.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="161,530 1405,530 1405,565 161,565"/>
        <TextEquiv conf="0.902"><Unicode>Den 2. Auguſt kamen wir nach Memel, der letzten Stadt des Rönigreichs. Der hafen war voll</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="160,578 1082,578 1082,613 160,613"/>
        <TextEquiv conf="0.916"><Unicode>von Schiffen aus holland und England, welche holz und Flachs laden.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="161,627 1286,627 1286,661 161,661"/>
        <TextEquiv conf="0.874"><Unicode>Den Sten waren wir in Tilſit an der Memel, und kehrten von da über Inſterburg nach</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="161,675 419,675 419,708 161,708"/>
        <TextEquiv conf="0.730"><Unicode>Rönigsberg zurück.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="161,722 1406,722 1406,757 161,757"/>
        <TextEquiv conf="0.866"><Unicode>Den 20ten Auguſt erreichten wir auf dem Rückwege Stettin, und den 25ten Colberg, wo dieſes</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="161,771 395,771 395,806 161,806"/>
        <TextEquiv conf="0.900"><Unicode>Tagebuch ſchließt.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
