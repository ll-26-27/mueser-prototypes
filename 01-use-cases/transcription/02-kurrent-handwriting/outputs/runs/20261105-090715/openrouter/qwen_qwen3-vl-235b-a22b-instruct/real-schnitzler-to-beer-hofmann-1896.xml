  <Page imageFilename="real-schnitzler-to-beer-hofmann-1896.jpg" imageWidth="1840" imageHeight="2040">
    <TextRegion id="r1">
      <Coords points="0,0 1840,0 1840,2040 0,2040"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Lieber Richard, fühl' ich mich prompt, daß</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>die ganzen Briefe, an denen wir jetzt arbeiten</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>etc. so fühl' ich, so zu mir selbst sprechen. Aber</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>dieser Brief wird gewandt, daß du mit</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>nichts als dem Wort und der That aus mir</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>zulassen. Meine ist froh, und wird</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>nun erst recht mit dir leben, wenn dafür geboren</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ist. Jetzt bin ich voll einer Idee, die</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>freundlich dämpfen und zu schalten, wird</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>aufwarten. Der Brief wird mir Weg</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>für dich bahnen, aber du wirst am Ende</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>stehen.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
