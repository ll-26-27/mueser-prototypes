    <TextRegion id="r1">
      <Coords points="0,0 1600,0 1600,2200 0,2200"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Lwif aͤß Köniͤgßberg, den 29. Juliuͤß 1786</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Liebſte Schweſter!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Geſtern ſind wir glüͤcklich in Köniͤgßberg angekommen, nachdem ſich der Weg von Elbing</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>uͤber die Uſſring zwoͤlf volle Tage geſtoͤßet hat. Der Sand iſt tief und die Pferde waren</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>müde. Wir woͤhnen bey dem Kaufmann Falbergß am Pregel, deſſen Frau Sie grüßen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>läßt.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Heute Vormittag ſahen wir den Profeſſor Kant beſucht. Er iſt klein und freundlich und</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ſpricht von allem, nur nicht von ſeinen Bücher. Morgen ſahren wir nach Memel, und von</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>da, ſo Gott will, über Tilsit zurück.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Schreibt mir nach Danzig, poſta reſtante. Ich bin und bleibe Euer treuer Bruder</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Friedrich.</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
