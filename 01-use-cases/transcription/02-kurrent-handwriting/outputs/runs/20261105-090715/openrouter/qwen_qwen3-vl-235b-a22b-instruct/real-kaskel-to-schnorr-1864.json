  {
   "text": "Jugendfreund Freund!",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "So freudig und unvergleichlich als",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "gestern in unerhörten Glanz",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Meyerbeers, fahr ich Heut so",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "furchtbarer Weise wieder fort,",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "obwohl so fest das auf Wunsch",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "der Gegenwart ist. Mein",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Freund wurde verdoppelt, als",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "ich seinen so liebenswürdigen, mit",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "überall unvergleichlichen Worten",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "unter den Zuförnern erblickt,",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "und mir sagte man diesfreude",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "vergessen müßte!",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Aber niemand vermöchte",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "großen Freund) mir, auf! das",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Glück nicht befehlen, seinen",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Raoul so zu führen!",
   "bbox": null,
   "baseline": null,
   "confidence": null
  },
  {
   "text": "Gott segne dich!",
   "bbox": null,
   "baseline": null,
