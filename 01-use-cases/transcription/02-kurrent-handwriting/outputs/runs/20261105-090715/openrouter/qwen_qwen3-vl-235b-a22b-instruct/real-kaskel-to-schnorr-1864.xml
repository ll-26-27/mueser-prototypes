  <Page imageFilename="real-kaskel-to-schnorr-1864.jpg" imageWidth="2030" imageHeight="1600">
    <TextRegion id="r1">
      <Coords points="0,0 2030,0 2030,1600 0,1600"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>84</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Jugendfreund Freund!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>So freudig und unvergleichlich als</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>gestern in unerhörten Glanz</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Meyerbeers, fahr ich Heut so</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>furchtbarer Weise wieder fort,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>obwohl so fest das auf Wunsch</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>der Gegenwart ist. Mein</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Freund wurde verdoppelt, als</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ich seinen so liebenswürdigen, mit</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>überall unvergleichlichen Worten</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>unter den Zuförnern erblickt,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>und mir sagte man diesfreude</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>vergessen müßte!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Aber niemand vermöchte</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l16">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>großen Freund) mir, auf! das</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l17">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Glück nicht befehlen, seinen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l18">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Raoul so zu führen!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l19">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gott segne dich!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l20">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gott sei mit dir</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l21">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>am 30ten Juny 1864 Carl Radeke</Unicode></TextEquiv>
      </TextLine>
    </TextRegion>
