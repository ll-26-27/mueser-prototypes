        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Mit grösster Freude, lieber Freund</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>habe ich Deine Zeilen empfangen. Dein</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Brief hat mich sehr erfreut. Ich freue mich</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>sehr, dass Du Dich so gut erholt hast. Es</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>freut mich, dass Du wieder so gut drauf bist.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Ich hoffe, Du wirst bald wieder ganz gesund.</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
