      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Ew. Wohlgeborne Schreiben vom 2ten dieses habe ich in Danzig richtig erhalten. Die Krüge aus</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
