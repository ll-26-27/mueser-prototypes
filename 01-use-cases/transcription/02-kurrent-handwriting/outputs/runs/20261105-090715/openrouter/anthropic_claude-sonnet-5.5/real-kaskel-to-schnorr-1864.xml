    <TextRegion id="r1">
      <Coords points="0,0 2030,0 2030,1600 0,1600"/>
      <TextLine id="l1">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>84</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l2">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Hochverehrter Freund!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l3">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>So herrlich und unvergleichlich als</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l4">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>gestern im unsterblichen Werke</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l5">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Meyerbeers, habe ich Ihren so</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l6">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>hochtrefflichen Sohn nie gehört,</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l7">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>obwohl er stets der erste Tenor</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l8">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>der Gegenwart ist. Meine</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l9">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Freude wurde verdoppelt, als</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l10">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ich seinen so hochverehrten, und</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l11">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>ebenfalls unvergleichlichen Vater</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l12">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>unter den Zuhörern erblick-</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l13">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>und mir sagte was Dieser da</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l14">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>empfinden müsste!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l15">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Aber meinem vereinigten</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l16">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>grossen Freunde war, ach! das</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l17">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Glück nicht beschieden, seinen</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l18">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Raoul so zu hören!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l19">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Gott erhalte Dir!</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l20">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Ihr treu ergebener</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l21">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>am 30t Juny</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l22">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>1864</Unicode></TextEquiv>
      </TextLine>
      <TextLine id="l23">
        <Coords points="0,0 0,0 0,0 0,0"/>
        <TextEquiv><Unicode>Carl Kaskel</Unicode></TextEquiv>
      </TextLine>
