# secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
._*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# editors / tools
.claude/settings.local.json

# local-only data: raw page dumps, DuckDB working stores, model weights and fonts (fetched by
# `python -m mueser.text.models fetch …`). Committed on purpose: the small fixture pages under
# inputs/, every run under outputs/runs/ (the audit trail), and the response cache under cache/.
**/inputs/raw/
**/*.duckdb
**/*.duckdb.wal
models/
/work/
**/operations/work/*.duckdb

# the Allmaps discovery cache is ~70 MB of world-map metadata; its result table is committed instead
cache/gazetteer_allmaps/
