# secrets
.env
.env.*
!.env.example

# macOS
.DS_Store
._*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# editors / tools
.claude/settings.local.json

# local-only data: raw page dumps, DuckDB working stores, model weights and fonts (fetched by
# `python -m mueser.text.models fetch …`). Committed on purpose: the small fixture pages under
# inputs/, every run under outputs/runs/ (the audit trail), and the response cache under cache/.
**/inputs/raw/
**/*.duckdb
**/*.duckdb.wal
models/
/work/
**/operations/work/*.duckdb

# the Allmaps discovery cache is ~70 MB of world-map metadata; its result table is committed instead
cache/gazetteer_allmaps/

# Ben's handouts, CV, manuscripts, mail and notes never enter this public repository. In the style and
# notes groups only code, config, labelled synthetic fixtures (synth-*) and reports he agrees to keep are
# committed; his documents under inputs/ and every derived store and run folder stay local.
01-use-cases/style/*/inputs/*
!01-use-cases/style/*/inputs/README.md
!01-use-cases/style/*/inputs/config/
!01-use-cases/style/*/inputs/fixtures/
01-use-cases/style/*/outputs/out/
.~lock.*#
01-use-cases/notes/*/inputs/inbox/*
!01-use-cases/notes/*/inputs/inbox/README.md
01-use-cases/notes/*/outputs/store/
01-use-cases/notes/*/outputs/exports/
01-use-cases/notes/*/outputs/inbox/
**/*.sqlite
**/*.sqlite-journal

# Ben's CV as data is his, even when the rest of the config is committed
01-use-cases/style/02-cv/inputs/config/cv.yml

# the Stanford Encyclopedia entry pages are ~150 MB of HTML, refetched in minutes; the metadata read from them is committed in sources/sep.json
cache/sep/
